@model List<klug_ausgeben.Models.Expense>

@{
    ViewData["Title"] = "Expenses";
}

<div class="text-center">
    <h1 class="display-4">Expenses</h1>
</div>

<a asp-action="CreateEditExpense" class="btn btn-primary mb-3">Add Expense</a>

@if (!Model.Any())
{
    <p class="text-muted">No expenses yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Value</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expense in Model)
            {
                <tr>
                    <td>@expense.Id</td>
                    <td>@expense.Value</td>
                    <td>@expense.Description</td>
                </tr>
            }
        </tbody>
    </table>
}
