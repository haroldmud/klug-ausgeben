@model List<klug_ausgeben.Models.Expense>

@{
    ViewData["Title"] = "Expenses";
}

<div class="text-center">
    <h1 class="display-4">Expenses</h1>
</div>

<a asp-action="CreateEditExpense" class="btn btn-primary mb-3">Add Expense</a>

@if (!Model.Any())
{
    <p class="text-muted">No expenses yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Value</th>
                <th>Description</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expense in Model)
            {
                <tr>
                    <td>@expense.Id</td>
                    <td>@expense.Value</td>
                    <td>@expense.Description</td>
                    <td>
                        <a asp-action="CreateEditExpense" asp-route-id="@expense.Id"
                           class="btn btn-sm btn-outline-secondary me-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="DeleteExpense" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@expense.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
